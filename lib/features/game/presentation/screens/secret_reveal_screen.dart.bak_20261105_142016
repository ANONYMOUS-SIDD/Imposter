const Color _blueBright = Color(0xFF0F2250);
const Color _blueMid = Color(0xFF040A1C);
const Color _blueDeep = Color(0xFF000308);
const Color _blueGlow = Color(0xFF6BA5F0);
const Color _cyanGlow = Color(0xFF22D3EE);
const Color _deepRed = Color(0xFF8B1E32);
const Color _darkRed = Color(0xFF4A0F1E);
const Color _nearBlackRed = Color(0xFF1A0812);

const double _revealThreshold = 0.55;
const double _minCardValue = 0.15;
const Duration _inactivityDelay = Duration(milliseconds: 3200);
const Duration _cardReturnDuration = Duration(milliseconds: 520);

const String _kCurrentUserLabel = 'CURRENT USER';
const String _kSwipeHintLabel = 'Swipe up on the card first';
const String _kStartPlayingLabel = 'START PLAYING';
const String _kPassDevicePrefix = 'Pass Device To ';
const String _kYourWordLabel = 'YOUR WORD IS';
const String _kYourHintLabel = 'YOUR HINT IS';
const String _kCivilianLabel = 'CIVILIAN';
const String _kImposterLabel = 'IMPOSTER';

const String _kReadyRouteName = 'ready';
const String _kSetupRouteName = 'setup';
const String _kHomeRouteName = 'home';

class SecretRevealScreen extends ConsumerStatefulWidget {
  const SecretRevealScreen({super.key});

  @override
  ConsumerState<SecretRevealScreen> createState() => _SecretRevealScreenState();
}

class _SecretRevealScreenState extends ConsumerState<SecretRevealScreen>
    with SingleTickerProviderStateMixin {
  late final AnimationController _cardController = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 500),
    value: 1.0,
  );

  /// `true` once the current player has peeked at their secret during this
  /// turn. Reset when the reveal index advances to the next player.
  bool _hasRevealedThisPlayer = false;

  /// Set when the last player's reveal causes the session's current player
  /// to become null. Used to guard the fallback navigation so it fires
  /// only once, even across rebuilds.
  bool _hasNavigatedAway = false;

  bool _showLottieHint = false;
  Timer? _inactivityTimer;

  @override
  void initState() {
    super.initState();
    _armInactivityTimer();
  }

  @override
  void dispose() {
    _inactivityTimer?.cancel();
    _cardController.dispose();
    super.dispose();
  }

  void _armInactivityTimer() {
    _inactivityTimer?.cancel();
    _showLottieHint = false;
    _inactivityTimer = Timer(_inactivityDelay, () {
      if (mounted && !_hasRevealedThisPlayer) {
        setState(() => _showLottieHint = true);
      }
    });
  }

  void _disarmInactivityTimer() {
    _inactivityTimer?.cancel();
    if (_showLottieHint) {
      setState(() => _showLottieHint = false);
    }
  }

  /// Resets per-player state when the reveal index advances.
  ///
  /// The card snaps back to fully covering rather than animating, because
  /// the content underneath belongs to the new player and must not be
  /// visible during the reset.
  void _resetForNewPlayer() {
    _hasRevealedThisPlayer = false;
    _cardController.value = 1.0;
    _armInactivityTimer();
  }

  void _onDragStart(DragStartDetails d) {
    _cardController.stop();
    _disarmInactivityTimer();
  }

  /// Updates the card position while the user drags.
  ///
  /// [cardHeight] comes from the enclosing `LayoutBuilder` so the delta is
  /// normalised against the card's actual height (post-SafeArea), not a
  /// rough estimate from the screen size.
  void _onDragUpdate(DragUpdateDetails d, double cardHeight) {
    if (cardHeight <= 0) return;
    final double delta = d.delta.dy / cardHeight;
    final double newValue =
    (_cardController.value + delta).clamp(_minCardValue, 1.0);
    _cardController.value = newValue;

    if (newValue < _revealThreshold && !_hasRevealedThisPlayer) {
      setState(() => _hasRevealedThisPlayer = true);
      HapticFeedback.lightImpact();
    }
  }

  void _onDragEnd(DragEndDetails d) {
    _cardController.animateTo(
      1.0,
      duration: _cardReturnDuration,
      curve: Curves.easeInCubic,
    );
  }

  /// Marks the current player as revealed and advances the session index.
  ///
  /// Navigation to Ready happens in the build method's null-player
  /// fallback, not here, so the Ready route is pushed exactly once.
  void _advance(BuildContext context, GameSession session) {
    if (!_hasRevealedThisPlayer) return;
    final int idx = session.currentRevealIndex;
    ref.read(gameSessionProvider.notifier).markRevealed(idx);
  }

  @override
  Widget build(BuildContext context) {
    ref.listen<int>(
      gameSessionProvider.select((s) => s?.currentRevealIndex ?? -1),
          (prev, next) {
        if (prev != next && prev != -1 && next >= 0 && mounted) {
          setState(_resetForNewPlayer);
        }
      },
    );

    final GameSession? session = ref.watch(gameSessionProvider);

    if (session == null) {
      return const _SessionNotFoundScreen();
    }

    // When the last player's reveal sets the session's current player to
    // null, render the previous frame's content for one frame so the
    // transition to Ready does not flash. Navigation to Ready happens in a
    // post-frame callback so it fires once.
    final Player? currentPlayer = session.currentPlayer;
    final bool isFallback = currentPlayer == null;
    final Player? player = currentPlayer ??
        (session.players.isNotEmpty ? session.players.last : null);

    if (player == null) {
      // Session with zero players. Show only the background rather than a
      // half-built screen.
      return Scaffold(
        backgroundColor: _blueDeep,
        body: const _DeepBlueBackground(),
      );
    }

    if (isFallback && !_hasNavigatedAway) {
      _hasNavigatedAway = true;
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted) context.goNamed(_kReadyRouteName);
      });
    }

    final bool isFirst = !isFallback && session.currentRevealIndex == 0;
    final bool isLast = isFallback ||
        session.currentRevealIndex == session.players.length - 1;
    final String? nextName = isLast
        ? null
        : session.players[session.currentRevealIndex + 1].name;

    return Scaffold(
      backgroundColor: _blueDeep,
      body: Stack(
        children: <Widget>[
          const _DeepBlueBackground(),
          SafeArea(
            child: Column(
              children: <Widget>[
                Expanded(
                  flex: 6,
                  child: LayoutBuilder(
                    builder: (BuildContext context, BoxConstraints c) {
                      final double cardHeight = c.maxHeight;

                      return ClipRRect(
                        borderRadius: const BorderRadius.vertical(
                          bottom: Radius.circular(32),
                        ),
                        child: Stack(
                          children: <Widget>[
                            Positioned.fill(
                              child: RepaintBoundary(
                                child: _RevealContent(
                                  player: player,
                                  session: session,
                                ),
                              ),
                            ),
                            Positioned.fill(
                              child: GestureDetector(
                                onVerticalDragStart: _onDragStart,
                                onVerticalDragUpdate: (DragUpdateDetails d) =>
                                    _onDragUpdate(d, cardHeight),
                                onVerticalDragEnd: _onDragEnd,
                                behavior: HitTestBehavior.opaque,
                                child: AnimatedBuilder(
                                  animation: _cardController,
                                  builder: (BuildContext context, Widget? child) {
                                    final double offset =
                                        -cardHeight * (1 - _cardController.value);
                                    return Transform.translate(
                                      offset: Offset(0, offset),
                                      child: child,
                                    );
                                  },
                                  // The card subtree is built once; only the
                                  // transform rebuilds each frame.
                                  child: _RevealCard(
                                    showLottieHint: _showLottieHint,
                                  ),
                                ),
                              ),
                            ),
                          ],
                        ),
                      );
                    },
                  ),
                ),
                Expanded(
                  flex: 4,
                  child: _PassSection(
                    currentName: player.name,
                    nextName: nextName,
                    hasRevealed: _hasRevealedThisPlayer,
                    isLast: isLast,
                    onContinue: () => _advance(context, session),
                  ),
                ),
              ],
            ),
          ),
          if (isFirst)
            Positioned(
              // Offset by the safe-area top so the button sits below the
              // notch, level with the content.
              top: MediaQuery.paddingOf(context).top + 4,
              left: 4,
              child: IconButton(
                icon: Icon(
                  Icons.arrow_back_rounded,
                  color: Colors.white.withValues(alpha: 0.85),
                  size: 22,
                ),
                onPressed: () => context.goNamed(_kSetupRouteName),
                tooltip: 'Back to setup',
              ),
            ),
        ],
      ),
    );
  }
}

/// Shown when [SecretRevealScreen] is reached without an active game
/// session. Presents an explicit error and a path back to Home rather than
/// a loading spinner.
class _SessionNotFoundScreen extends StatelessWidget {
  const _SessionNotFoundScreen();

  @override
  Widget build(BuildContext context) {
    final AppLocalizations? l10n = AppLocalizations.of(context);
    final String title = l10n?.gameSessionNotFound ?? 'Game session not found';
    final String message = l10n?.startNewGamePrompt ??
        'Start a new game from the home screen.';
    final String cta = l10n?.backToHome ?? 'Back to Home';

    return Scaffold(
      backgroundColor: _blueDeep,
      body: SafeArea(
        child: Center(
          child: Padding(
            padding: const EdgeInsets.symmetric(horizontal: 32),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: <Widget>[
                Icon(
                  Icons.error_outline_rounded,
                  size: 56,
                  color: _blueGlow.withValues(alpha: 0.9),
                ),
                const SizedBox(height: 20),
                Text(
                  title,
                  style: AppTypography.title,
                  textAlign: TextAlign.center,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                ),
                const SizedBox(height: 10),
                Text(
                  message,
                  style: AppTypography.body.copyWith(
                    color: Colors.white.withValues(alpha: 0.7),
                  ),
                  textAlign: TextAlign.center,
                  maxLines: 3,
                  overflow: TextOverflow.ellipsis,
                ),
                const SizedBox(height: 28),
                SizedBox(
                  width: double.infinity,
                  child: FilledButton(
                    onPressed: () => context.goNamed(_kHomeRouteName),
                    style: FilledButton.styleFrom(
                      backgroundColor: _blueGlow,
                      foregroundColor: _blueDeep,
                      minimumSize: const Size(0, 48),
                    ),
                    child: Text(
                      cta,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

/// Draggable card that covers the secret.
///
/// The card carries the background gradient, an image at its bottom edge,
/// several vignette layers, and an optional Lottie hint that appears after
/// inactivity. All layers are wrapped in `IgnorePointer` or `Positioned`
/// so they cannot intercept the drag gesture handled by the parent.
class _RevealCard extends StatelessWidget {
  const _RevealCard({required this.showLottieHint});

  final bool showLottieHint;

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        borderRadius: const BorderRadius.vertical(
          bottom: Radius.circular(32),
        ),
        gradient: const LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: <Color>[
            Color(0xFF1A1442),
            Color(0xFF0F0A28),
            Color(0xFF05030F),
          ],
          stops: <double>[0.0, 0.55, 1.0],
        ),
        boxShadow: <BoxShadow>[
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.55),
            blurRadius: 32,
            spreadRadius: -6,
            offset: const Offset(0, 18),
          ),
          BoxShadow(
            color: _cyanGlow.withValues(alpha: 0.18),
            blurRadius: 52,
            spreadRadius: 0,
            offset: const Offset(0, 6),
          ),
          BoxShadow(
            color: _blueBright.withValues(alpha: 0.40),
            blurRadius: 20,
            spreadRadius: -6,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: ClipRRect(
        borderRadius: const BorderRadius.vertical(
          bottom: Radius.circular(32),
        ),
        child: Stack(
          children: <Widget>[
            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              height: 290,
              child: Image.asset(
                'assets/images/imposter8.png',
                fit: BoxFit.contain,
                errorBuilder: (BuildContext context, Object e, StackTrace? s) {
                  return Center(
                    child: Icon(
                      Icons.visibility_rounded,
                      size: 120,
                      color: _blueGlow.withValues(alpha: 0.5),
                    ),
                  );
                },
              ),
            ),

            if (showLottieHint)
              Positioned(
                bottom: -80,
                left: 0,
                right: 0,
                child: IgnorePointer(
                  child: Center(
                    child: Lottie.asset(
                      'assets/animations/Scene.json',
                      height: 260,
                      fit: BoxFit.contain,
                      errorBuilder: (BuildContext context, Object e, StackTrace? s) =>
                      const SizedBox.shrink(),
                    ),
                  ),
                ),
              ),

            Positioned.fill(
              child: IgnorePointer(
                child: DecoratedBox(
                  decoration: BoxDecoration(
                    borderRadius: const BorderRadius.vertical(
                      bottom: Radius.circular(32),
                    ),
                    gradient: RadialGradient(
                      center: Alignment.center,
                      radius: 1.2,
                      colors: <Color>[
                        Colors.transparent,
                        const Color(0xFF243B52).withValues(alpha: 0.55),
                      ],
                      stops: const <double>[0.45, 1.0],
                    ),
                  ),
                ),
              ),
            ),

            Positioned.fill(
              child: IgnorePointer(
                child: DecoratedBox(
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: <Color>[
                        _cyanGlow.withValues(alpha: 0.06),
                        Colors.transparent,
                        Colors.transparent,
                        const Color(0xFF243B52).withValues(alpha: 0.30),
                      ],
                      stops: const <double>[0.0, 0.25, 0.75, 1.0],
                    ),
                  ),
                ),
              ),
            ),

            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              height: 100,
              child: IgnorePointer(
                child: DecoratedBox(
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: <Color>[
                        Colors.transparent,
                        _blueDeep.withValues(alpha: 0.35),
                        _blueDeep.withValues(alpha: 0.85),
                      ],
                      stops: const <double>[0.0, 0.55, 1.0],
                    ),
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

/// Player name shown in the bottom pass section.
///
/// Uppercase, single line, with ellipsis so long names or large text scales
/// truncate rather than push the button off-screen.
class _AnimatedPlayerName extends StatelessWidget {
  const _AnimatedPlayerName({required this.name});

  final String name;

  @override
  Widget build(BuildContext context) {
    return Text(
      name.toUpperCase(),
      style: AppTypography.display.copyWith(
        fontSize: 17,
        fontWeight: FontWeight.w700,
        letterSpacing: 0.8,
        color: const Color(0xFFE0E0EA),
      ),
      textAlign: TextAlign.center,
      maxLines: 1,
      overflow: TextOverflow.ellipsis,
      softWrap: false,
    );
  }
}

/// Content shown underneath the card — role icon, role label, and the
/// player's word or hint.
///
/// Wrapped in a `SingleChildScrollView` with a `ConstrainedBox(minHeight)`
/// so that large text scales or long words scroll instead of overflowing
/// the card's fixed height. When content fits, the `Center` keeps it
/// vertically centered.
class _RevealContent extends StatelessWidget {
  const _RevealContent({
    required this.player,
    required this.session,
  });

  final Player player;
  final GameSession session;

  @override
  Widget build(BuildContext context) {
    final bool isImposter = player.role == PlayerRole.imposter;
    final bool isHidden = session.settings.hiddenImposterMode;
    final bool showAsImposter = isImposter && !isHidden;

    // Imposters with the hint disabled see no word at all. In hidden mode
    // they see the hint, styled as a civilian word. In normal mode with
    // hints enabled they see the hint but the role label reads "IMPOSTER".
    final bool shouldShowWord;
    if (isImposter) {
      if (isHidden) {
        shouldShowWord = true;
      } else if (session.settings.imposterHintEnabled) {
        shouldShowWord = true;
      } else {
        shouldShowWord = false;
      }
    } else {
      shouldShowWord = true;
    }

    final String langMode = session.settings.languageMode;
    // In `both` mode, skip the Nepali line for words whose translation
    // matches the English (custom words, which have no separate Nepali
    // text) so the word does not appear twice.
    final String? rawWord = !shouldShowWord
        ? null
        : isImposter
        ? session.imposterHint.resolve(langMode)
        : ((langMode == 'both' &&
        session.originalWord.english == session.originalWord.nepali)
        ? session.originalWord.english
        : session.originalWord.localized.resolve(langMode));
    final String word = (rawWord ?? '').toUpperCase();

    final Color accent = showAsImposter ? _deepRed : _blueGlow;

    return Container(
      decoration: BoxDecoration(
        gradient: showAsImposter
            ? const RadialGradient(
          center: Alignment.center,
          radius: 1.3,
          colors: <Color>[_nearBlackRed, _darkRed, _nearBlackRed],
          stops: <double>[0.0, 0.6, 1.0],
        )
            : RadialGradient(
          center: Alignment.center,
          radius: 1.3,
          colors: <Color>[
            _blueMid,
            _blueBright.withValues(alpha: 0.55),
            _blueMid,
          ],
          stops: const <double>[0.0, 0.6, 1.0],
        ),
      ),
      padding: const EdgeInsets.symmetric(horizontal: 28),
      child: LayoutBuilder(
        builder: (BuildContext context, BoxConstraints c) {
          return SingleChildScrollView(
            physics: const ClampingScrollPhysics(),
            child: ConstrainedBox(
              constraints: BoxConstraints(minHeight: c.maxHeight),
              child: Center(
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  mainAxisSize: MainAxisSize.min,
                  children: <Widget>[
                    Container(
                      width: 76,
                      height: 76,
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        gradient: showAsImposter
                            ? const LinearGradient(
                          begin: Alignment.topLeft,
                          end: Alignment.bottomRight,
                          colors: <Color>[_deepRed, _darkRed],
                        )
                            : const LinearGradient(
                          begin: Alignment.topLeft,
                          end: Alignment.bottomRight,
                          colors: <Color>[_blueGlow, _blueBright],
                        ),
                        border: Border.all(
                          color: accent.withValues(alpha: 0.8),
                          width: 2,
                        ),
                        boxShadow: <BoxShadow>[
                          BoxShadow(
                            color: accent.withValues(alpha: 0.35),
                            blurRadius: 24,
                            spreadRadius: -4,
                          ),
                        ],
                      ),
                      child: Icon(
                        showAsImposter
                            ? Icons.warning_amber_rounded
                            : Icons.groups_rounded,
                        size: 38,
                        color: Colors.white.withValues(alpha: 0.9),
                      ),
                    ),
                    const SizedBox(height: 22),

                    Text(
                      showAsImposter ? _kImposterLabel : _kCivilianLabel,
                      style: AppTypography.label.copyWith(
                        fontSize: 11,
                        letterSpacing: 2.2,
                        color: accent,
                        fontWeight: FontWeight.w800,
                      ),
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      textAlign: TextAlign.center,
                    ),
                    const SizedBox(height: 20),

                    if (shouldShowWord && word.isNotEmpty) ...<Widget>[
                      Text(
                        showAsImposter ? _kYourHintLabel : _kYourWordLabel,
                        style: AppTypography.label.copyWith(
                          letterSpacing: 2.2,
                          fontSize: 11,
                          fontWeight: FontWeight.w800,
                          color: Colors.white.withValues(alpha: 0.62),
                        ),
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        textAlign: TextAlign.center,
                      ),
                      const SizedBox(height: 8),
                      Padding(
                        padding: const EdgeInsets.symmetric(horizontal: 8),
                        child: Text(
                          word,
                          style: AppTypography.display.copyWith(
                            fontSize: 18,
                            fontWeight: FontWeight.w700,
                            letterSpacing: 1.0,
                            height: 1.5,
                          ),
                          textAlign: TextAlign.center,
                          softWrap: true,
                          maxLines: 3,
                          overflow: TextOverflow.ellipsis,
                        ),
                      ),
                    ],
                  ],
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}

/// Bottom section: current player name, primary CTA, and swipe hint.
///
/// The label area is `Expanded` + `SingleChildScrollView` so it never
/// overflows on short screens. The CTA is pinned below the scroll area so
/// it remains reachable regardless of label length or text scale.
class _PassSection extends StatelessWidget {
  const _PassSection({
    required this.currentName,
    required this.nextName,
    required this.hasRevealed,
    required this.isLast,
    required this.onContinue,
  });

  final String currentName;
  final String? nextName;
  final bool hasRevealed;
  final bool isLast;
  final VoidCallback onContinue;

  @override
  Widget build(BuildContext context) {
    final double buttonMargin =
    ((MediaQuery.sizeOf(context).width * 0.11).clamp(32.0, 64.0) - 24)
        .clamp(0.0, double.infinity);

    return Padding(
      padding: const EdgeInsets.fromLTRB(24, 28, 24, 0),
      child: Column(
        children: <Widget>[
          Expanded(
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: <Widget>[
                  Text(
                    _kCurrentUserLabel,
                    style: AppTypography.label.copyWith(
                      fontSize: 12,
                      letterSpacing: 1.6,
                      color: Colors.white.withValues(alpha: 0.62),
                      fontWeight: FontWeight.w800,
                    ),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    textAlign: TextAlign.center,
                  ),
                  const SizedBox(height: 4),
                  _AnimatedPlayerName(name: currentName),
                ],
              ),
            ),
          ),

          Padding(
            padding: EdgeInsets.symmetric(horizontal: buttonMargin),
            child: _PassButton(
              label: isLast
                  ? _kStartPlayingLabel
                  : '$_kPassDevicePrefix${nextName ?? ''}',
